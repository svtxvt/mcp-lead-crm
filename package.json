{
  "name": "mcp-lead-crm",
  "version": "0.2.1",
  "description": "A local MCP lead CRM with JSON/CSV storage and optional n8n webhooks.",
  "type": "module",
  "bin": {
    "mcp-lead-crm": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "examples",
    "docs"
  ],
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "author": "Sergey Yashchuk",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
